# Expense Tracker Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API key for the agents
OPENAI_API_KEY=your_openai_api_key_here

# Required: Your unique user ID (used as partition key in DynamoDB)
USER_ID=your_username

# AWS Configuration
AWS_REGION=ap-southeast-2
TABLE_NAME=ExpenseTracker
BUDGETS_TABLE=ExpenseBudgets

# Optional: AWS credentials (if not using AWS CLI profile or IAM role)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
